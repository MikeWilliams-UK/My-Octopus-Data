query getChargeHistory(
  $accountNumber: String!,
  $after: DateTime!,
  $before: DateTime!, 
  $sessionTypes: [ChargingSessionType!], 
  $numberOfSessions: Int!, 
  $deviceId: String)
{
  devices(accountNumber: $accountNumber, deviceId: $deviceId) {
    ... on SmartFlexVehicle {
      chargingSessions(
        last: $numberOfSessions
        after: $after
        before: $before
        sessionTypes: $sessionTypes
      ) {
        edges {
          node {
            start
            end
            energyAdded {
              value
              unit
            }
            cost {
              amount
              currency
            }
            ... on SmartFlexChargingSession {
              type
              problems {
                ... on SmartFlexChargingError {
                  cause
                }
                ... on SmartFlexChargingTruncation {
                  truncationCause
                }
              }
            }
            ... on PublicChargingSession {
              location
            }
          }
        }
        pageInfo {
          hasPreviousPage
          startCursor
        }
      }
    }
    ... on SmartFlexChargePoint {
      chargingSessions(
        last: $numberOfSessions
        after: $after
        before: $before
        sessionTypes: $sessionTypes
      ) {
        edges {
          node {
            start
            end
            energyAdded {
              value
              unit
            }
            cost {
              amount
              currency
            }
            ... on SmartFlexChargingSession {
              type
              problems {
                ... on SmartFlexChargingError {
                  cause
                }
                ... on SmartFlexChargingTruncation {
                  truncationCause
                }
              }
            }
            ... on PublicChargingSession {
              location
            }
          }
        }
        pageInfo {
          hasPreviousPage
          startCursor
        }
      }
    }
  }
}