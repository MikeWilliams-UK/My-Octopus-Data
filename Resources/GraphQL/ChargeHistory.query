query getChargeHistory($accountNumber: String!, $after: DateTime!, $before: DateTime!, $sessionTypes: [ChargingSessionType!], $numberOfSessions: Int!, $deviceId: String) {
  devices(accountNumber: $accountNumber, deviceId: $deviceId) {
    ... on SmartFlexVehicle {
      chargingSessions(
        last: $numberOfSessions
        after: $after
        before: $before
        sessionTypes: $sessionTypes
      ) {
        edges {
          node {
            start
            end
            energyAdded {
              value
              unit
            }
            cost {
              amount
              currency
            }
            ... on SmartFlexChargingSession {
              type
              problems {
                ... on SmartFlexChargingError {
                  cause
                }
                ... on SmartFlexChargingTruncation {
                  truncationCause
                  achievableStateOfCharge
                  originalAchievableStateOfCharge
                }
              }
              targetType
              stateOfChargeChange
              stateOfChargeFinal
              cost {
                amount
                currency
              }
            }
          }
        }
        pageInfo {
          hasPreviousPage
          startCursor
        }
      }
    }
    ... on SmartFlexChargePoint {
      chargingSessions(
        last: $numberOfSessions
        after: $after
        before: $before
        sessionTypes: $sessionTypes
      ) {
        edges {
          node {
            start
            end
            energyAdded {
              value
              unit
            }
            ... on SmartFlexChargingSession {
              type
              problems {
                ... on SmartFlexChargingError {
                  cause
                }
                ... on SmartFlexChargingTruncation {
                  truncationCause
                  achievableStateOfCharge
                  originalAchievableStateOfCharge
                }
              }
              targetType
              stateOfChargeFinal
              stateOfChargeChange
            }
            cost {
              amount
              currency
            }
          }
        }
        pageInfo {
          hasPreviousPage
          startCursor
        }
      }
    }
  }
}